    {
      "id": "6d11418e-403a-4730-9823-e74eaf2722ed",
      "name": "Get writer settings",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1620,
        100
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.DIRECTUS_URL }}/items/writer_settings",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",

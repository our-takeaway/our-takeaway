      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "ea565d76-b491-4b6d-a8e0-bee7e171b605",
      "name": "Note 19",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        480,
        320
      ],
      "parameters": {
        "content": "### Publish\nRebuild the static site (the worker pulls published posts from Directus), then post on X and Reddit once — a saved link means it was already posted.",
        "width": 420,
        "height": 140,
        "color": 6
      }
    },
    {
      "id": "ab2a7179-7ef5-4598-95d0-13d7f4bfba8c",
      "name": "Get the post to publish",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        520
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.DIRECTUS_URL }}/items/posts/{{ $('Read the event').item.json.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.DIRECTUS_TOKEN }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a4a9f99c-a3fa-40b2-943d-527860e5efb0",
      "name": "Ready to publish?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        520
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Refuse to publish a post that has no text yet (e.g. approved before the AI finished).\nconst post = $json.data;\nif (!post.slug) throw new Error('This post has no slug yet. Wait for the AI draft, or fill in the slug.');\nconst langs = ['fa', 'en'].filter((l) => post['title_' + l]?.trim() && post['body_' + l]?.trim());\nif (!langs.length) throw new Error('This post has no title and text in either language yet.');\nreturn { json: post };"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "2636fbde-f4bf-41aa-96e3-2ae014f4a3cb",
      "name": "Mark as publishing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        520
      ],
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.DIRECTUS_URL }}/items/posts/{{ $('Read the event').item.json.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.DIRECTUS_TOKEN }}"
            }
          ]
        },
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: \"publishing\", error_message: null, published_at: $json.published_at || $now.toISO() }) }}"
      }
    },
    {
      "id": "b569cfc4-aaa7-41d0-8dea-e984d7992b55",
      "name": "Rebuild the site",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1180,
        520
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WORKER_URL }}/build",
        "sendHeaders": true,

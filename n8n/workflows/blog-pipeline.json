    {
      "id": "fdcfa2ac-a4c1-4da7-83e9-20f499b7005b",
      "name": "Build the AI request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1840,
        100
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Everything the AI needs: instructions from Directus + this meeting's material.\nconst settings = $json.data;\nconst post = $('Get the post').item.json.data;\nconst whisper = $('Save the transcript').isExecuted ? $('Save the transcript').item.json.data : null;\nconst transcript = (whisper?.transcript ?? post.transcript ?? '').trim();\nif (!transcript) throw new Error('No transcript. Paste one into the post, or attach audio and tick \"Transcribe the audio\".');\n\nconst status = $('Read the event').item.json.status;\nconst revising = status === 'revise' && post.feedback?.trim() && post.body_fa;\n\nconst meeting = [\n  post.title ? `Working title: ${post.title}` : '',\n  post.meeting_number != null ? `Meeting number: ${post.meeting_number}` : '',\n  `Date: ${(post.date_created || new Date().toISOString()).slice(0, 10)}`,\n  post.notes ? `Notes from the hosts:\\n${post.notes}` : '',\n].filter(Boolean).join('\\n');\nconst material = [\n  `Social language: ${settings.social_language || 'en'}`,\n  `<meeting>\\n${meeting}\\n</meeting>`,\n  `<transcript>\\n${transcript}\\n</transcript>`,\n];\nif (revising) {\n  const current = {};\n  for (const k of ['slug','title_fa','description_fa','tags_fa','body_fa','title_en','description_en','tags_en','body_en','tweet','reddit_title','reddit_body']) current[k] = post[k];\n  material.push(`<current_draft>\\n${JSON.stringify(current, null, 2)}\\n</current_draft>`);\n  material.push(`<reviewer_feedback>\\n${post.feedback}\\n</reviewer_feedback>`);\n}\n\nconst str = { type: 'string' };\nconst list = { type: 'array', items: str };\nconst fields = { slug: str, title_fa: str, description_fa: str, tags_fa: list, body_fa: str, title_en: str, description_en: str, tags_en: list, body_en: str, tweet: str, reddit_title: str, reddit_body: str };\n\nreturn {\n  json: {\n    request: {\n      model: settings.model || 'deepseek/deepseek-v4-flash-0731',\n      max_tokens: 32000,\n      messages: [\n        { role: 'system', content: settings.system_prompt },\n        { role: 'user', content: material.join('\\n\\n') },\n      ],\n      response_format: {\n        type: 'json_schema',\n        json_schema: { name: 'blog_post', strict: true, schema: { type: 'object', properties: fields, required: Object.keys(fields), additionalProperties: false } },\n      },\n    },\n  },\n};"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "a4035dcd-c210-490d-8dd5-1e4640c073b5",
      "name": "Ask the AI (OpenRouter)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2060,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENROUTER_BASE_URL || \"https://openrouter.ai/api/v1\" }}/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.OPENROUTER_API_KEY }}"
            },
            {
              "name": "X-Title",
              "value": "Our Takeaway"
            }
          ]
        },
        "options": {
          "timeout": 900000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.request) }}"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "91d4a2de-5aed-4a6c-bb03-2ef97ece45e6",
      "name": "Check the AI answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2280,
        100
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Parse and sanity-check the JSON the model returned.\nconst choice = $json.choices?.[0];\nif (!choice) throw new Error('OpenRouter returned no answer: ' + JSON.stringify($json).slice(0, 500));\nif (choice.finish_reason === 'length') throw new Error('The answer was cut off (too long). Try again or shorten the transcript.');\nlet draft;\ntry { draft = JSON.parse(choice.message.content); }\ncatch { throw new Error('The AI answer was not valid JSON: ' + String(choice.message.content).slice(0, 300)); }\n\nfor (const k of ['title_fa', 'body_fa', 'title_en', 'body_en']) {\n  if (!draft[k]?.trim()) throw new Error(`The AI answer is missing ${k}`);\n}\n\nconst post = $('Get the post').item.json.data;\nconst slugify = (s) => String(s || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 80);\nconst tags = (t) => [...new Set((t || []).map((x) => String(x).trim().replace(/^#/, '')).filter(Boolean))].slice(0, 6);\n\nreturn {\n  json: {\n    // keep the URL stable once a post has been published\n    slug: post.published_at && post.slug ? post.slug : slugify(draft.slug) || `meeting-${post.id}`,\n    title_fa: draft.title_fa.trim(),\n    description_fa: draft.description_fa.trim(),\n    tags_fa: tags(draft.tags_fa),\n    body_fa: draft.body_fa.trim() + '\\n',\n    title_en: draft.title_en.trim(),\n    description_en: draft.description_en.trim(),\n    tags_en: tags(draft.tags_en),\n    body_en: draft.body_en.trim() + '\\n',\n    tweet: draft.tweet.trim(),\n    reddit_title: draft.reddit_title.trim().slice(0, 300),\n    reddit_body: draft.reddit_body.trim(),\n    feedback: null,\n    error_message: null,\n    status: 'review',\n  },\n};"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "c7f23d25-9229-475d-b68e-4894c26d43cb",
      "name": "Is the slug taken?",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2500,
        100
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.DIRECTUS_URL }}/items/posts?filter[slug][_eq]={{ encodeURIComponent($json.slug) }}&filter[id][_neq]={{ $('Read the event').item.json.id }}&fields=id&limit=1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [

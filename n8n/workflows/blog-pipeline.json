  "nodes": [
    {
      "id": "357d7e26-c401-4c82-afb7-93f843c83cf9",
      "name": "Note 0",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -260,
        -420
      ],
      "parameters": {
        "content": "## Blog pipeline\nDirectus sends every change to a **post** here. We look at the new **status** and pick a path:\n- **new / revise** → AI writes the draft (top row)\n- **approved** → rebuild the site, post on X and Reddit (middle row)\n- **archived** → rebuild the site without it (bottom row)\n\nEverything else (processing, review, published…) is ignored, so our own status updates never loop.",
        "width": 520,
        "height": 300,
        "color": 4
      }
    },
    {
      "id": "18064e53-76e4-4dea-bf8b-d1bb756c4ea8",
      "name": "Directus: post changed",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -200,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "directus-posts",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "7121b82d-1776-422f-84fc-1b18833fbf61"
    },
    {
      "id": "a4a34560-19c5-45ff-9214-9b89ec147160",
      "name": "Read the event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        20,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Directus Flow sends: { event, keys | key, payload, collection }\nconst out = [];\nfor (const item of $input.all()) {\n  const secret = item.json.headers['x-webhook-secret'];\n  if (!secret || secret !== $env.N8N_WEBHOOK_SECRET) throw new Error('Wrong webhook secret');\n\n  const body = item.json.body;\n  const ids = body.keys ?? (body.key != null ? [body.key] : []);\n  const created = String(body.event).endsWith('.create');\n  // A new post counts as \"new\" even if the form didn't send the status.\n  const status = body.payload?.status ?? (created ? 'new' : null);\n\n  // One item per post (bulk edits can touch several at once).\n  for (const id of ids) out.push({ json: { id, status } });\n}\nreturn out;"
      }
    },

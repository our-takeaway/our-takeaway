    {
      "id": "1cab8f45-3a94-4098-9fbd-d51fd9bbfeb0",
      "name": "Use a free slug",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2720,
        100
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Another post already uses this slug → add this post's number to keep URLs unique.\nconst draft = { ...$('Check the AI answer').item.json };\nif ($json.data?.length) draft.slug = `${draft.slug}-${$('Read the event').item.json.id}`;\nreturn { json: draft };"
      }
    },

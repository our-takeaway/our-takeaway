---
import { render } from 'astro:content';
import { LANGS, type Lang } from '../../../consts';
import Base from '../../../layouts/Base.astro';
import { digits, formatDate, otherLang, readingMinutes, t } from '../../../lib/i18n';
import { getPosts, type Post } from '../../../lib/posts';

export async function getStaticPaths() {
	const paths = [];
	for (const lang of LANGS) {
		const posts = await getPosts(lang);
		// posts are newest-first: "newer" is i-1, "older" is i+1
		paths.push(
			...posts.map((post, i) => ({
				params: { lang, slug: post.data.slug },
				props: { post, newer: posts[i - 1], older: posts[i + 1] },
			})),
		);
	}
	return paths;
}

interface Props {
	post: Post;
	newer?: Post;
	older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, tags, meeting, slug, langs } = post.data;
const lang = Astro.params.lang as Lang;
const other = otherLang(lang);
const altHref = langs.includes(other) ? `/${other}/blog/${slug}/` : `/${other}/`;
---

<Base lang={lang} title={title} description={description} type="article" altHref={altHref}>
	<article class="post">
		<header class="post-header">
			<div class="meta">
				{meeting != null && <span class="badge">{t(lang, 'meeting')} {digits(meeting, lang)}</span>}
				<time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang)}</time>
				<span>·</span>
				<span>{digits(readingMinutes(post.body), lang)} {t(lang, 'minRead')}</span>
			</div>
			<h1>{title}</h1>
			<p class="lede">{description}</p>
			{updatedDate && updatedDate.toDateString() !== pubDate.toDateString() && (
				<p class="muted small">{t(lang, 'updated')} {formatDate(updatedDate, lang)}</p>
			)}
		</header>
		<div class="prose">
			<Content />
		</div>
		{tags.length > 0 && (
			<p class="tags">
				{tags.map((tag) => <a class="tag" href={`/${lang}/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}
			</p>
		)}
	</article>
	<nav class="post-nav">
		{older ? <a href={`/${lang}/blog/${older.data.slug}/`}><small>{t(lang, 'prev')}</small>{older.data.title}</a> : <span />}
		{newer ? <a href={`/${lang}/blog/${newer.data.slug}/`}><small>{t(lang, 'next')}</small>{newer.data.title}</a> : <span />}
	</nav>
</Base>

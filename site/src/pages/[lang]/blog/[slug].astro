---
import { render } from 'astro:content';
import { LANGS, SITE, type Lang } from '../../../consts';
import Base from '../../../layouts/Base.astro';
import { digits, formatDate, otherLang, readingMinutes, t } from '../../../lib/i18n';
import { getPosts, type Post } from '../../../lib/posts';
import { tagSlug } from '../../../lib/tags';

export async function getStaticPaths() {
	const paths = [];
	for (const lang of LANGS) {
		const posts = await getPosts(lang);
		// posts are newest-first: "newer" is i-1, "older" is i+1
		paths.push(
			...posts.map((post, i) => ({
				params: { lang, slug: post.data.slug },
				props: { post, newer: posts[i - 1], older: posts[i + 1] },
			})),
		);
	}
	return paths;
}

interface Props {
	post: Post;
	newer?: Post;
	older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, tags, meeting, slug, langs, sourceLang } = post.data;
const lang = Astro.params.lang as Lang;
const other = otherLang(lang);
const otherHref = langs.includes(other) ? `/${other}/blog/${slug}/` : undefined;
// this version is the AI translation when the session was in the other language
const original = sourceLang && sourceLang !== lang && otherHref ? otherHref : undefined;

const url = new URL(`/${lang}/blog/${slug}/`, Astro.site).href;
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	inLanguage: lang,
	url,
	mainEntityOfPage: url,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	image: new URL('/og.png', Astro.site).href,
	keywords: tags.join(', ') || undefined,
	author: SITE[lang].authors.map((name) => ({ '@type': 'Person', name })),
	publisher: { '@type': 'Organization', name: SITE[lang].title, url: new URL(`/${lang}/`, Astro.site).href },
	isPartOf: { '@type': 'Blog', name: SITE[lang].title, url: new URL(`/${lang}/`, Astro.site).href },
};
// "<" escaped so a title can never close the script tag
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<Base lang={lang} title={title} description={description} type="article" altHref={otherHref}>
	<Fragment slot="head">
		<meta property="article:published_time" content={pubDate.toISOString()} />
		{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
		{tags.map((tag) => <meta property="article:tag" content={tag} />)}
		<script type="application/ld+json" set:html={jsonLdText} />
	</Fragment>
	<article class="post">
		<header class="post-header">
			<div class="meta">
				{meeting != null && <span class="badge">{t(lang, 'meeting')} {digits(meeting, lang)}</span>}
				<time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang)}</time>
				<span>·</span>
				<span>{digits(readingMinutes(post.body), lang)} {t(lang, 'minRead')}</span>
			</div>
			<h1>{title}</h1>
			<p class="lede">{description}</p>
			{updatedDate && updatedDate.toDateString() !== pubDate.toDateString() && (
				<p class="muted small">{t(lang, 'updated')} {formatDate(updatedDate, lang)}</p>
			)}
		</header>
		<div class="prose">
			<Content />
		</div>
		{tags.length > 0 && (
			<p class="tags">
				{tags.map((tag) => <a class="tag" href={`/${lang}/tags/${encodeURIComponent(tagSlug(tag))}/`}>#<bdi>{tag}</bdi></a>)}
			</p>
		)}
		<aside class="post-footer">
			<p class="muted small">
				{t(lang, 'aiNote')}
				{original && (
					<>
						{' '}{t(lang, 'translatedNote')}{' '}
						<a href={original} hreflang={other}>{t(lang, 'readOriginal')}</a>
					</>
				)}
			</p>
		</aside>
	</article>
	<nav class="post-nav">
		{older ? <a href={`/${lang}/blog/${older.data.slug}/`}><small>{t(lang, 'prev')}</small>{older.data.title}</a> : <span />}
		{newer ? <a href={`/${lang}/blog/${newer.data.slug}/`}><small>{t(lang, 'next')}</small>{newer.data.title}</a> : <span />}
	</nav>
</Base>

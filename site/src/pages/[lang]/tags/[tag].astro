---
import PostList from '../../../components/PostList.astro';
import { LANGS, type Lang } from '../../../consts';
import Base from '../../../layouts/Base.astro';
import { getPosts } from '../../../lib/posts';
import { tagSlug } from '../../../lib/tags';

export async function getStaticPaths() {
	const paths = [];
	for (const lang of LANGS) {
		const posts = await getPosts(lang);
		// slug → the spelling posts show (already the same on every post, see lib/tags.ts)
		const tags = new Map(posts.flatMap((p) => p.data.tags).map((tag) => [tagSlug(tag), tag]));
		paths.push(
			...[...tags].map(([slug, label]) => ({
				params: { lang, tag: slug },
				props: { label, posts: posts.filter((p) => p.data.tags.some((tag) => tagSlug(tag) === slug)) },
			})),
		);
	}
	return paths;
}

const lang = Astro.params.lang as Lang;
const { label, posts } = Astro.props;
---

<Base lang={lang} title={`#${label}`}>
	<h1>#<bdi>{label}</bdi></h1>
	<PostList lang={lang} posts={posts} />
</Base>

---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { LINKS, SITE, type Lang } from '../consts';
import { dirOf, otherLang, t } from '../lib/i18n';

interface Props {
	lang: Lang;
	title?: string;
	description?: string;
	type?: 'website' | 'article';
	// The same page in the other language. Leave it out when the page has no
	// translation: the language switch then goes to that language's home, and no
	// hreflang link is added (it would point search engines at the wrong page).
	altHref?: string;
}

const { lang, title, description = SITE[lang].description, type = 'website' } = Astro.props;
const other = otherLang(lang);
const translated = Astro.props.altHref !== undefined;
const altHref = Astro.props.altHref ?? `/${other}/`;
const site = SITE[lang];
const fullTitle = title ? `${title} | ${site.title}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const altUrl = new URL(altHref, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const locale = (l: Lang) => (l === 'fa' ? 'fa_IR' : 'en_US');
const path = Astro.url.pathname;
const nav = [
	{ href: `/${lang}/`, label: t(lang, 'home') },
	{ href: `/${lang}/blog/`, label: t(lang, 'allPosts') },
	{ href: `/${lang}/about/`, label: t(lang, 'about') },
];
---

<!doctype html>
<html lang={lang} dir={dirOf(lang)}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<script is:inline>
			// Apply a saved light/dark choice before the page paints (no flash).
			try {
				const theme = localStorage.getItem('theme');
				if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
			} catch {}
		</script>
		<meta name="theme-color" content="#f6f2ea" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#191713" media="(prefers-color-scheme: dark)" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonical} />
		{translated && (
			<>
				<link rel="alternate" hreflang={lang} href={canonical} />
				<link rel="alternate" hreflang={other} href={altUrl} />
				<link rel="alternate" hreflang="x-default" href={lang === 'en' ? canonical : altUrl} />
			</>
		)}
		<link rel="alternate" type="application/rss+xml" title={site.title} href={new URL(`/${lang}/rss.xml`, Astro.site)} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<Font cssVariable="--font-vazir" preload />
		<Font cssVariable="--font-serif" preload={lang === 'en'} />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content={site.title} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={locale(lang)} />
		{translated && <meta property="og:locale:alternate" content={locale(other)} />}
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${SITE.en.title} · ${SITE.fa.title}`} />
		<meta name="twitter:card" content="summary_large_image" />
		<slot name="head" />
	</head>
	<body>
		<a class="skip-link" href="#main">{t(lang, 'skipToContent')}</a>
		<header class="site-header">
			<div class="wrap header-inner">
				<a class="brand" href={`/${lang}/`}>
					<svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
						<rect width="32" height="32" rx="9" fill="var(--accent)" />
						<path d="M9 11h14M9 16h14M9 21h8" stroke="var(--bg)" stroke-width="2.6" stroke-linecap="round" />
						<circle cx="23" cy="21" r="2.6" fill="var(--note-ink)" />
					</svg>
					<span>{site.title}</span>
				</a>
				<nav aria-label={site.title}>
					{nav.map((n) => (
						<a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
					))}
					<a class="lang-switch" href={altHref} hreflang={other} lang={other} data-lang={other}>{t(lang, 'switchTo')}</a>
					<button class="theme-toggle" type="button" aria-label={t(lang, 'theme')} title={t(lang, 'theme')}>
						<svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
						<svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
					</button>
				</nav>
			</div>
		</header>
		<main class="wrap" id="main" tabindex="-1">
			<slot />
		</main>
		<footer class="site-footer">
			<div class="wrap footer-inner">
				<span>© {new Date().getFullYear()} {site.title}</span>
				<span class="footer-links">
					<a href={`/${lang}/about/`}>{t(lang, 'about')}</a>
					<a href={`/${lang}/rss.xml`}>RSS</a>
					{LINKS.map((l) => <a href={l.href} rel="me noopener">{l.label}</a>)}
				</span>
			</div>
		</footer>
		<script is:inline>
			// Remember the reader's choice so "/" sends them to the same language next time.
			document.querySelector('.lang-switch')?.addEventListener('click', (e) => {
				document.cookie = `lang=${e.currentTarget.dataset.lang}; path=/; max-age=31536000; SameSite=Lax`;
			});
			// Light/dark switch: starts from the system setting, remembers an explicit choice.
			document.querySelector('.theme-toggle')?.addEventListener('click', () => {
				const root = document.documentElement;
				const current = root.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
				const next = current === 'dark' ? 'light' : 'dark';
				root.dataset.theme = next;
				try {
					localStorage.setItem('theme', next);
				} catch {}
			});
		</script>
	</body>
</html>

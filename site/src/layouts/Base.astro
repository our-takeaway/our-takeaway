---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { CONTACT_EMAIL, LINKS, SITE, type Lang } from '../consts';
import { dirOf, otherLang, t } from '../lib/i18n';

interface Props {
	lang: Lang;
	title?: string;
	description?: string;
	type?: 'website' | 'article';
	// The same page in the other language. Leave it out when the page has no
	// translation: the language switch then goes to that language's home, and no
	// hreflang link is added (it would point search engines at the wrong page).
	altHref?: string;
}

const { lang, title, description = SITE[lang].description, type = 'website' } = Astro.props;
const other = otherLang(lang);
const translated = Astro.props.altHref !== undefined;
const altHref = Astro.props.altHref ?? `/${other}/`;
const site = SITE[lang];
const fullTitle = title ? `${title} | ${site.title}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const altUrl = new URL(altHref, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const locale = (l: Lang) => (l === 'fa' ? 'fa_IR' : 'en_US');
const path = Astro.url.pathname;
const nav = [
	{ href: `/${lang}/`, label: t(lang, 'home') },
	{ href: `/${lang}/blog/`, label: t(lang, 'allPosts') },
	{ href: `/${lang}/about/`, label: t(lang, 'about') },
];
---

<!doctype html>
<html lang={lang} dir={dirOf(lang)}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonical} />
		{translated && (
			<>
				<link rel="alternate" hreflang={lang} href={canonical} />
				<link rel="alternate" hreflang={other} href={altUrl} />
				<link rel="alternate" hreflang="x-default" href={lang === 'en' ? canonical : altUrl} />
			</>
		)}
		<link rel="alternate" type="application/rss+xml" title={site.title} href={new URL(`/${lang}/rss.xml`, Astro.site)} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<Font cssVariable="--font-vazir" preload />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content={site.title} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={locale(lang)} />
		{translated && <meta property="og:locale:alternate" content={locale(other)} />}
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${SITE.en.title} · ${SITE.fa.title}`} />
		<meta name="twitter:card" content="summary_large_image" />
		<slot name="head" />
	</head>
	<body>
		<a class="skip-link" href="#main">{t(lang, 'skipToContent')}</a>
		<header class="site-header">
			<div class="wrap header-inner">
				<a class="brand" href={`/${lang}/`}>{site.title}</a>
				<nav>
					{nav.map((n) => (
						<a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
					))}
					<a class="lang-switch" href={altHref} hreflang={other} lang={other} data-lang={other}>{t(lang, 'switchTo')}</a>
				</nav>
			</div>
		</header>
		<main class="wrap" id="main" tabindex="-1">
			<slot />
		</main>
		<footer class="site-footer">
			<div class="wrap footer-inner">
				<span>© {new Date().getFullYear()} {site.title}</span>
				<span class="footer-links">
					<a href={`mailto:${CONTACT_EMAIL}`}>{t(lang, 'contact')}</a>
					<a href={`/${lang}/rss.xml`}>RSS</a>
					{LINKS.map((l) => <a href={l.href} rel="me noopener">{l.label}</a>)}
				</span>
			</div>
		</footer>
		<script is:inline>
			// Remember the reader's choice so "/" sends them to the same language next time.
			document.querySelector('.lang-switch')?.addEventListener('click', (e) => {
				document.cookie = `lang=${e.currentTarget.dataset.lang}; path=/; max-age=31536000; SameSite=Lax`;
			});
		</script>
	</body>
</html>

# ---------- Domains (each needs an A record pointing at the VPS) ----------
# www.<SITE_DOMAIN> also needs one; it redirects to SITE_DOMAIN.
SITE_DOMAIN=our-takeaway.blog
CMS_DOMAIN=cms.our-takeaway.blog
N8N_DOMAIN=n8n.our-takeaway.blog
TIMEZONE=Asia/Tehran

# ---------- Directus login (the CMS where you review posts) ----------
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

# ---------- Secrets: fill each with a random value ----------
# generate one with:  openssl rand -hex 32
POSTGRES_PASSWORD=
DIRECTUS_SECRET=
DIRECTUS_TOKEN=
N8N_ENCRYPTION_KEY=
N8N_WEBHOOK_SECRET=
WORKER_SECRET=
SEARXNG_SECRET=

# ---------- Extra password in front of the n8n editor ----------
# Make the hash with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# and keep the single quotes (the hash contains $ signs).
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_HASH=''

# ---------- AI (OpenRouter) ----------
# https://openrouter.ai/keys — the model itself is chosen in Directus → Writer Settings
OPENROUTER_API_KEY=

# ---------- Speech to text: recordings → transcript ----------
# ElevenLabs (default): https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Whisper (optional backup, pick it in Directus → Writer Settings)
# Groq is cheap and fast: https://console.groq.com/keys
TRANSCRIBE_API_KEY=
TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
TRANSCRIBE_MODEL=whisper-large-v3

# ---------- Optional: social posting ----------
# Turn on after adding the X / Reddit credentials inside n8n (see README)
X_ENABLED=false
REDDIT_ENABLED=false

# ---------- Optional: Telegram message when a draft is ready ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
